@startuml Shared_Kernel_Compact

!theme plain
left to right direction
skinparam backgroundColor white
skinparam componentStyle rectangle
skinparam padding 0
skinparam BoxPadding 2
skinparam RectanglePadding 3
skinparam RectangleBorderThickness 1
skinparam Shadowing false
skinparam Nodesep 10
skinparam Ranksep 10

rectangle "Núcleo Compartilhado" #EEEEEE {
    rectangle "Utilitários Criptográficos" as crypto #E0E0E0 {
        rectangle "crypto/" {
            file "**certificates.py**\njson_to_bytes()\nverify_signature_bytes()\nsign_bytes()\nload_public_key_from_der_b64()\nload_private_key_from_pem()"
            file "**payword.py**\nPayword\ncreate()\npayment_proof_b64()\nPaywordPebbleCache"
            file "**paytree.py**\nPaytree\ncreate()\npayment_proof()"
        }
    }

    rectangle "Modelos de Protocolo Compartilhados" as proto #E0E0E0 {
        rectangle "application/shared" {
            file "**payment_channel_payloads.py**\nOpenChannelRequestPayload\nSignatureChannelSettlementPayload\nSignatureChannelPaymentPayload"
            file "**payword_payloads.py**\nPaywordOpenChannelRequestPayload"
            file "**paytree_payloads.py**\nPaytreeOpenChannelRequestPayload"
        }
    }
    
    rectangle "Utilitários de Infraestrutura" as infra #E0E0E0 {
        rectangle "infrastructure/" {
            file "**database.py**\nDatabaseClient\nget_database_client()"
            file "**storage.py**\nKeyValueStore\nRedisKeyValueStore"
            file "**http/http_client.py**\nHttpClient"
        }
    }
    
    
}

@enduml