@startuml Phase2b_Subsequent_Payments

!theme plain
autonumber

hide footbox

actor "Cliente" as Client
participant "API do Vendedor" as Vendor
database "BD do Vendedor\n(Redis)" as VendorDB

loop para cada pagamento subsequente

    Client -> Client: Construir pagamento

    Client -> Vendor: Enviar pagamento
    activate Vendor

    Vendor -> VendorDB: Buscar canal e pagamento
    VendorDB --> Vendor: dados do canal/pagamento

    Vendor -> Vendor: Verificar pagamento recebido

    Vendor -> VendorDB: Atualizar pagamento
    VendorDB --> Vendor: OK
    
    Vendor --> Client: confirmação do pagamento
    deactivate Vendor

end

@enduml
