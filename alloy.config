discovery.docker "local_containers" {
  host = "unix:///var/run/docker.sock"
}

pyroscope.ebpf "instance" {
  forward_to  = [pyroscope.write.endpoint.receiver]
  targets     = discovery.docker.local_containers.targets
  // Default is 19/s (confirmed against Alloy's source -- the docs disagree with
  // themselves, some pages say 97). At 19/s, a sub-millisecond function called
  // on every request (e.g. the vendor's repository save/get calls) only gets
  // ~1 sample per 250-380 requests, so the per-mode db/crypto/other CPU-time
  // splits bench-plotter's profile_macro_micro.png draws from it are built
  // from a few dozen to ~100 raw samples each -- noisy enough that a 20-40%
  // swing between modes is indistinguishable from sampling variance. 97/s
  // roughly quintuples that sample count for the same run duration.
  sample_rate = 97
  // Default is 15s: how often this profiler flushes accumulated samples to
  // Pyroscope, which sets the coarsest chunk Pyroscope's storage holds this
  // data in (bench_plotter/profiling/aggregate.py's docstring calls this out
  // as "CPU comes back in 15s buckets"). A benchmark run's profiled window
  // (run_duration = PAYMENT_COUNT_PER_RUN / TPS in run_benchmark.sh) only
  // covers a handful of these at high TPS, so which side of a chunk boundary
  // the window edge lands on swings the reported CPU-time sum. Unlike
  // widening the window (more payments, more run time), narrowing this
  // interval doesn't cost any extra benchmark run time -- it only makes
  // Alloy flush more often, each flush just carrying fewer samples. 1s
  // keeps even the sweep's shortest window (TPS_PER_CLIENT in
  // run_benchmark.sh) at ~90 buckets instead of ~10 -- the tradeoff is
  // Alloy pushing to Pyroscope, and profiling every container on the host
  // (not just vendor), 15x more often than the 15s default.
  collect_interval = "1s"
}

pyroscope.write "endpoint" {
  endpoint {
    url = "http://pyroscope:4040"
  }
  external_labels = {
    "env"      = "docker",
    "instance" = env("HOSTNAME"),
  }
}


